# ---- Application ----
# One of: development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Security ----
# Comma-separated keys. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=replace-with-a-strong-random-key
# Must be at least 32 characters outside development
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_MINUTES=30
RATE_LIMIT_PER_MINUTE=20
MAX_REQUEST_BYTES=100000
# Comma-separated allowed origins, e.g. https://careers.example.com (empty = CORS disabled)
CORS_ORIGINS=

# ---- LLM ----
# mock = deterministic engine, no API key needed. Options: mock | anthropic | openai
LLM_PROVIDER=mock
# e.g. claude-sonnet-5-5 (anthropic) or gpt-4o-mini (openai)
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3

# ---- Pipeline ----
PIPELINE_TIMEOUT_SECONDS=120
MAX_REVIEW_REVISIONS=1
